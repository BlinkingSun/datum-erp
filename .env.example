# Development-only placeholders. Production must not use these passwords or loopback trust.
# Canon: docs/12-configuration.md. This file is a strict subset of that table.
# names are D3's (research/decisions/audit-persistence.md §1.1)
# The process does not load .env (ABSENT); export these or pass the CLI/TOML equivalents.

# required-at-boot — WICKET_BLOB_ROOT is the only hard production boot failure (no TOML/CLI fallback).
# The directory must already exist and be writable; boot does not create it.
WICKET_BLOB_ROOT=/tmp/wicket-blobs
WICKET_DATABASE_URL=postgres://wicket_app:wicket@127.0.0.1:5432/wicket_test?sslmode=disable
WICKET_MIGRATE_DATABASE_URL=postgres://wicket_migrate:wicket@127.0.0.1:5432/wicket_test?sslmode=disable
WICKET_BOOTSTRAP_URL=postgres://127.0.0.1:5432/postgres?sslmode=disable   # MacBook loopback trust; other nodes add user:password
WICKET_PROFILE=plain-shop

# optional-at-runtime
# WICKET_BIND=0.0.0.0:8080
# WICKET_CONFIG=/path/to/wicket.toml
# WICKET_GENEALOGY_INLINE_MAX=32

# test-only. WICKET_REQUIRE_PG is the test harness, not a production boot requirement.
# WICKET_TEST_TEMPLATE=wicket_test_template
# WICKET_TEST_DB=wicket_test
# WICKET_REQUIRE_PG=1   (CI only: a missing database is a failure, not a skip)
# WICKET_TEST_CHILD=1
# WICKET_DB_GC_MIN=60
